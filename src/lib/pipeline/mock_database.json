  "documents": [
    {
      "id": "doc-reach-001",
      "source_type": "fir",
      "title": "Margrave Homicide Report - FIR-2022-GA-084",
      "raw_text": "On 2026-08-28, the body of Joe Reacher was found near the Margrave Underpass. Chief Oscar Finlay and Officer Roscoe Conklin are lead investigators alongside Jack Reacher. A suspect vehicle, a black Bentley with plate GA-04-XX-4444, was spotted nearby. Burner phone number +91 92203 44502 triggered cell tower pings at the underpass coordinate during the homicide window.",
      "file_hash": "hash_reach_001",
      "file_size": 256,
      "mime_type": "text/plain",
      "status": "processed",
      "created_at": "2026-08-28T15:48:46.452Z"
    },
    {
      "id": "doc-reach-002",
      "source_type": "transaction",
      "title": "Kliner Foundation Cash Structuring Ledger",
      "raw_text": "Audit of Kliner Foundation financial ledgers reveals multiple cash wire transfers in Margrave to banker Paul Hubble. Transfers are structured in increments of Rs 45,000 to bypass structuring limits. Hubble has been coordinating with KJ Kliner.",
      "file_hash": "hash_reach_002",
      "file_size": 312,
      "mime_type": "text/plain",
      "status": "processed",
      "created_at": "2026-08-28T15:48:46.452Z"
    },
    {
      "id": "doc-reach-003",
      "source_type": "cdr",
      "title": "Burner Phone CDR Intercept Logs",
      "raw_text": "Call detail records (CDR) show phone calls between burner SIM +91 92203 44502 and Paul Hubble's personal device, peaking during the time of the Margrave counterfeiting operations under KJ Kliner, monitored by Oscar Finlay and Jack Reacher.",
      "file_hash": "hash_reach_003",
      "file_size": 198,
      "mime_type": "text/plain",
      "status": "processed",
      "created_at": "2026-08-28T15:48:46.452Z"
    }
